# Static file server for the built site, inside the kibitz container.
# The homelab's public Caddy handles HTTPS and proxies
# ethantyoung.com/projects/kibitz/* here with the prefix stripped.
{
	admin off
	auto_https off
	persist_config off
}

# Same policy as the <meta> CSP in vite.config.ts, plus frame-ancestors,
# which only works as a header. Imported for normal and error responses.
(security_headers) {
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self' https://api.chess.com https://lichess.org; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}
}

:8080 {
	root * /srv
	import security_headers

	# Static site: only reads.
	@notread not method GET HEAD
	respond @notread 405

	# Hashed build files never change; the engine changes only on upgrades.
	header ?Cache-Control no-cache
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /engine/* Cache-Control "public, max-age=604800"

	# Serve the .zst/.gz copies made at build time; nothing is compressed per request.
	file_server {
		hide .*
		precompressed zstd gzip
	}

	handle_errors {
		import security_headers
		header Cache-Control no-store
		respond "{err.status_code} {err.status_text}"
	}
}
